{
  "expo": {
    "name": "deep-player",
    "slug": "deep-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-11.png",
    "scheme": "deepplayer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.deep.player",
      "adaptiveIcon": {
        "backgroundColor": "#202020",
        "foregroundImage": "./assets/images/icon-11.png",
        "backgroundImage": "./assets/images/icon-11.png",
        "monochromeImage": "./assets/images/icon-11.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon-3.webp"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#202020",
          "image": "./assets/images/splash.png",
          "imageWidth": 144
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPictures": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A7EA4"
        }
      ],
      "expo-media-library",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Icon2",
            "ios": "./assets/images/icon-2.png",
            "android": {
              "foregroundImage": "./assets/images/icon-2.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "Icon3",
            "ios": "./assets/images/icon-3.png",
            "android": {
              "foregroundImage": "./assets/images/icon-3.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "Icon4",
            "ios": "./assets/images/icon-4.png",
            "android": {
              "foregroundImage": "./assets/images/icon-4.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "Icon11",
            "ios": "./assets/images/icon-11.png",
            "android": {
              "foregroundImage": "./assets/images/icon-11.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "IconB",
            "ios": "./assets/images/icon-b.png",
            "android": {
              "foregroundImage": "./assets/images/icon-b.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "IconBl",
            "ios": "./assets/images/icon-bl.png",
            "android": {
              "foregroundImage": "./assets/images/icon-bl.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "IconBw",
            "ios": "./assets/images/icon-bw.png",
            "android": {
              "foregroundImage": "./assets/images/icon-bw.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "IconC",
            "ios": "./assets/images/icon-c.png",
            "android": {
              "foregroundImage": "./assets/images/icon-c.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "IconL",
            "ios": "./assets/images/icon-l.png",
            "android": {
              "foregroundImage": "./assets/images/icon-l.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "IconP",
            "ios": "./assets/images/icon-p.png",
            "android": {
              "foregroundImage": "./assets/images/icon-p.png",
              "backgroundColor": "#202020"
            }
          },
          {
            "name": "IconW",
            "ios": "./assets/images/icon-w.png",
            "android": {
              "foregroundImage": "./assets/images/icon-w.png",
              "backgroundColor": "#202020"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bf15c266-ce64-45e4-8d43-4e3832be8c67"
      }
    }
  }
}
