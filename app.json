{
  "expo": {
    "name": "Deep Player",
    "slug": "deep-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-purple.png",
    "scheme": "deepplayer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-purple.png",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.deep.player",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon-purple.png",
        "backgroundImage": "./assets/images/icon-purple.png",
        "monochromeImage": "./assets/images/icon-purple.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon-purple.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B12",
          "image": "./assets/images/splash.png",
          "imageWidth": 144
        }
      ],
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Deep Player to use Face ID to unlock your library."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": true,
          "hidden": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7887FF"
        }
      ],
      "expo-media-library",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "IconPurple",
            "ios": "./assets/images/icon-purple.png",
            "android": {
              "foregroundImage": "./assets/images/icon-purple.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "IconGreen",
            "ios": "./assets/images/icon-green.png",
            "android": {
              "foregroundImage": "./assets/images/icon-green.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "IconSunset",
            "ios": "./assets/images/icon-sunset.png",
            "android": {
              "foregroundImage": "./assets/images/icon-sunset.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "IconRed",
            "ios": "./assets/images/icon-red.png",
            "android": {
              "foregroundImage": "./assets/images/icon-red.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "IconBlue",
            "ios": "./assets/images/icon-blue.png",
            "android": {
              "foregroundImage": "./assets/images/icon-blue.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "IconAurora",
            "ios": "./assets/images/icon-aurora.png",
            "android": {
              "foregroundImage": "./assets/images/icon-aurora.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "IconBlack",
            "ios": "./assets/images/icon-black.png",
            "android": {
              "foregroundImage": "./assets/images/icon-black.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "IconLime",
            "ios": "./assets/images/icon-lime.png",
            "android": {
              "foregroundImage": "./assets/images/icon-lime.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        ]
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bf15c266-ce64-45e4-8d43-4e3832be8c67"
      }
    }
  }
}
